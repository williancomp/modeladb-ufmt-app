{
  "name": "modeladb",
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write src",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "E2E_COVERAGE=1 playwright test && node e2e/coverage-report.mjs",
    "evaluate": "node evaluation/run.mjs",
    "figures": "node evaluation/figures/figures.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.57.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^9.0.0",
    "globals": "16.5.0",
    "graphql": "16.11.0",
    "mysql2": "3.15.3",
    "pg": "8.16.3",
    "prettier": "^3.3.0",
    "tailwindcss": "4.3.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.12"
  },
  "description": "ModelaDB: browser-based editor for Chen-style and Crow's Foot ER/EER diagrams with validation and code generation",
  "license": "MIT",
  "author": "Willian Garcias de Assunção <willian.assuncao@ufmt.br>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williancomp/modeladb-ufmt-app.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "private": true,
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
